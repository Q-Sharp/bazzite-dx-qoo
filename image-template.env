# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=bazzite-dx-qoo

# Make this the same as your github username/organisation
REPO_ORGANIZATION="Q-Sharp"

IMAGE_DESC="bazzite dx with current qoo kernel and modules, for use with nvidia graphics cards"
IMAGE_KEYWORDS="bootc,oci,linux,nvidia,graphics,drivers,modules"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/8755388?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="ghcr.io/ublue-os/bazzite-dx-nvidia:stable"
